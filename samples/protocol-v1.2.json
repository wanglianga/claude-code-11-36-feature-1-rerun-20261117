{
  "version": "v1.2",
  "rules": {
    "index_date": {
      "basis": "first_visit",
      "merge_visit_types": [
        "screening",
        "baseline"
      ]
    },
    "consent": {
      "required": true
    },
    "inclusion": {
      "age_min": 18,
      "age_max": 70,
      "diagnosis": {
        "codes": [
          "T2DM"
        ],
        "window_days": 3650
      },
      "lab": {
        "code": "CREATININE",
        "study_unit": "mg/dL",
        "min": 0.4,
        "max": 2.05,
        "window_days_before": 30,
        "window_days_after": 0
      },
      "medication": {
        "codes": [
          "METFORMIN"
        ],
        "within_days_after_index": 30
      }
    },
    "exclusion": {
      "diagnosis": {
        "codes": [
          "ADV"
        ]
      },
      "lab": {
        "code": "HEMOGLOBIN",
        "max": 8.0,
        "window_days_before": 30
      }
    },
    "endpoints": {
      "primary_efficacy": {
        "label": "主要疗效终点：索引后 60–200 天随访缓解",
        "visit_types": [
          "follow_up"
        ],
        "window_days": [
          60,
          200
        ],
        "required_response": [
          "CR",
          "PR"
        ]
      }
    },
    "follow_up": {
      "visits": [
        {
          "day": 30,
          "kind": "safety"
        },
        {
          "day": 90,
          "kind": "efficacy"
        },
        {
          "day": 180,
          "kind": "efficacy"
        }
      ]
    },
    "safety": {
      "allow_retention_after_withdrawal": true
    }
  }
}